---
// Schematic drawings of four page-turning approaches. Not to scale.
---
<figure class="fig">
  <svg viewBox="0 0 760 270" role="img" aria-labelledby="pt-t pt-d" width="760" height="270">
    <title id="pt-t">Four ways to turn Kindle pages without swiping</title>
    <desc id="pt-d">Schematic drawings of a Bluetooth remote with two large buttons beside a Kindle, a clip-on tapper attached to a Kindle screen edge, a magnetic cover with physical buttons on the side, and a Kindle being double-tapped on its back edge.</desc>
    <g font-family="sans-serif" font-size="13" fill="#1d1b18" text-anchor="middle">
      <!-- remote -->
      <g transform="translate(20,10)">
        <rect x="8" y="14" width="76" height="104" rx="5" fill="#2f5d57"/><rect x="16" y="24" width="60" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <path d="M96 66 q14 -14 28 0 M92 78 q22 -26 44 0" fill="none" stroke="#9a3b1f" stroke-width="2.5"/>
        <rect x="120" y="44" width="34" height="76" rx="14" fill="#e9e4da" stroke="#1d1b18" stroke-width="2"/>
        <circle cx="137" cy="66" r="9" fill="#8d8a86"/><circle cx="137" cy="98" r="9" fill="#8d8a86"/>
        <text x="90" y="170" font-weight="700">Bluetooth remote</text>
        <text x="90" y="188" fill="#4a453d">Kindle must accept it</text>
        <text x="90" y="206" fill="#4a453d">Amazon's Click: 2024+</text>
      </g>
      <!-- clip-on -->
      <g transform="translate(210,10)">
        <rect x="35" y="14" width="76" height="104" rx="5" fill="#2f5d57"/><rect x="43" y="24" width="60" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <path d="M100 56 h20 v24 h-20" fill="#8d8a86" stroke="#1d1b18" stroke-width="2"/>
        <circle cx="94" cy="68" r="5" fill="#9a3b1f"/>
        <rect x="132" y="66" width="22" height="42" rx="10" fill="#e9e4da" stroke="#1d1b18" stroke-width="2"/>
        <path d="M128 76 q-4 8 0 16" fill="none" stroke="#9a3b1f" stroke-width="2.5"/>
        <text x="90" y="170" font-weight="700">Clip-on tapper</text>
        <text x="90" y="188" fill="#4a453d">Radio remote, pad taps the glass</text>
        <text x="90" y="206" fill="#4a453d">Works on any touch screen</text>
      </g>
      <!-- button cover -->
      <g transform="translate(400,10)">
        <rect x="30" y="14" width="86" height="104" rx="5" fill="#2f5d57"/><rect x="38" y="24" width="64" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <rect x="116" y="30" width="14" height="30" rx="4" fill="#8d8a86" stroke="#1d1b18" stroke-width="2"/>
        <rect x="116" y="68" width="14" height="30" rx="4" fill="#8d8a86" stroke="#1d1b18" stroke-width="2"/>
        <text x="90" y="170" font-weight="700">Button cover</text>
        <text x="90" y="188" fill="#4a453d">Amazon's Page-Turn Cover</text>
        <text x="90" y="206" fill="#4a453d">2026 Signature Editions</text>
      </g>
      <!-- double tap -->
      <g transform="translate(590,10)">
        <rect x="40" y="14" width="76" height="104" rx="5" fill="#2f5d57"/><rect x="48" y="24" width="60" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <circle cx="132" cy="70" r="6" fill="none" stroke="#9a3b1f" stroke-width="2.5"/><circle cx="132" cy="70" r="13" fill="none" stroke="#9a3b1f" stroke-width="2"/>
        <text x="85" y="170" font-weight="700">Double tap</text>
        <text x="85" y="188" fill="#4a453d">Tap the side or back twice</text>
        <text x="85" y="206" fill="#4a453d">Signature Editions only</text>
      </g>
    </g>
  </svg>
  <figcaption>Our own schematic, not to scale and not based on any specific product. Which Kindle supports which approach is explained below.</figcaption>
</figure>
