---
// Schematic drawings of four stand types. Not to scale.
---
<figure class="fig">
  <svg viewBox="0 0 760 270" role="img" aria-labelledby="st-t st-d" width="760" height="270">
    <title id="st-t">Four kinds of Kindle stand</title>
    <desc id="st-d">Schematic drawings of a weighted desk stand with an adjustable arm, a clamp-on gooseneck holder, a lap pillow with a holder, and a charging dock with a ledge.</desc>
    <g font-family="sans-serif" font-size="13" fill="#1d1b18" text-anchor="middle">
      <!-- desk stand -->
      <g transform="translate(20,10)">
        <rect x="35" y="150" width="110" height="14" rx="5" fill="#4a453d"/>
        <rect x="86" y="70" width="8" height="80" fill="#6b665c"/>
        <g transform="rotate(-14 90 70)"><rect x="52" y="6" width="76" height="104" rx="5" fill="#2f5d57"/><rect x="60" y="16" width="60" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/></g>
        <text x="90" y="196" font-weight="700">Weighted desk stand</text>
        <text x="90" y="214" fill="#4a453d">Adjustable tilt and height</text>
        <text x="90" y="232" fill="#4a453d">Weight is what keeps it steady</text>
      </g>
      <!-- gooseneck -->
      <g transform="translate(210,10)">
        <rect x="8" y="110" width="26" height="76" rx="3" fill="#8e6c46"/>
        <path d="M34 140 C 70 140, 60 60, 96 52" fill="none" stroke="#6b665c" stroke-width="7" stroke-linecap="round"/>
        <rect x="76" y="14" width="76" height="104" rx="5" fill="#2f5d57"/>
        <rect x="84" y="24" width="60" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <text x="90" y="212" font-weight="700">Clamp + gooseneck</text>
        <text x="90" y="230" fill="#4a453d">Headboard or table edge</text>
        <text x="90" y="248" fill="#4a453d">Arm can flex when you tap</text>
      </g>
      <!-- pillow -->
      <g transform="translate(400,10)">
        <path d="M10 160 Q 90 130 170 160 L 170 186 Q 90 170 10 186 Z" fill="#b9ad94"/>
        <g transform="rotate(-24 90 120)"><rect x="52" y="40" width="76" height="104" rx="5" fill="#2f5d57"/><rect x="60" y="50" width="60" height="78" rx="2" fill="#faf6ee" stroke="#1d1b18"/></g>
        <text x="90" y="212" font-weight="700">Lap or bed pillow</text>
        <text x="90" y="230" fill="#4a453d">Soft base, no clamp</text>
        <text x="90" y="248" fill="#4a453d">Angle is mostly fixed</text>
      </g>
      <!-- dock -->
      <g transform="translate(590,10)">
        <rect x="30" y="150" width="110" height="18" rx="6" fill="#4a453d"/>
        <rect x="52" y="70" width="70" height="82" rx="4" fill="#6b665c"/>
        <rect x="58" y="14" width="58" height="100" rx="5" fill="#2f5d57" transform="rotate(-6 87 64)"/>
        <rect x="64" y="24" width="46" height="72" rx="2" fill="#faf6ee" stroke="#1d1b18" transform="rotate(-6 87 64)"/>
        <text x="85" y="196" font-weight="700">Charging dock</text>
        <text x="85" y="214" fill="#4a453d">Charges and props upright</text>
        <text x="85" y="232" fill="#4a453d">Named models only</text>
      </g>
    </g>
  </svg>
  <figcaption>Our own schematic, not to scale and not based on any specific product.</figcaption>
</figure>
