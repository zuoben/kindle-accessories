---
---
<figure class="fig">
  <svg viewBox="0 0 760 250" role="img" aria-labelledby="ct-t ct-d" width="760" height="250">
    <title id="ct-t">Four common Kindle case styles</title>
    <desc id="ct-d">Simple drawings of a folio cover, a slim back shell, a sleeve and a stand-style case.</desc>
    <g font-family="sans-serif" font-size="13" fill="#1d1b18" text-anchor="middle">
      <!-- folio -->
      <g transform="translate(20,20)">
        <rect x="0" y="10" width="70" height="140" rx="6" fill="#7a5b3a"/>
        <rect x="76" y="10" width="70" height="140" rx="6" fill="#8e6c46"/>
        <rect x="84" y="22" width="54" height="102" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <rect x="68" y="10" width="10" height="140" fill="#5f4529"/>
        <text x="73" y="185" font-weight="700">Folio cover</text><text x="73" y="203" fill="#4a453d">Covers the screen</text>
      </g>
      <!-- shell -->
      <g transform="translate(215,20)">
        <rect x="20" y="10" width="100" height="140" rx="10" fill="#2f5d57"/>
        <rect x="30" y="22" width="80" height="102" rx="2" fill="#faf6ee" stroke="#1d1b18"/>
        <text x="70" y="185" font-weight="700">Slim shell</text><text x="70" y="203" fill="#4a453d">Back + edges only</text>
      </g>
      <!-- sleeve -->
      <g transform="translate(400,20)">
        <rect x="20" y="30" width="110" height="130" rx="6" fill="#b9ad94"/>
        <path d="M20 30h110v26H20z" fill="#9c9078"/>
        <rect x="68" y="42" width="14" height="6" rx="3" fill="#faf6ee"/>
        <text x="75" y="185" font-weight="700">Sleeve / pouch</text><text x="75" y="203" fill="#4a453d">For bags, not for reading</text>
      </g>
      <!-- stand -->
      <g transform="translate(580,20)">
        <rect x="20" y="10" width="110" height="140" rx="8" fill="#9a3b1f" transform="rotate(-6 75 80)"/>
        <rect x="32" y="24" width="86" height="102" rx="2" fill="#faf6ee" stroke="#1d1b18" transform="rotate(-6 75 80)"/>
        <path d="M60 150l15 20 15-20z" fill="#5f4529"/>
        <text x="75" y="185" font-weight="700">Stand / strap case</text><text x="75" y="203" fill="#4a453d">Hands-free or one-hand</text>
      </g>
    </g>
  </svg>
  <figcaption>Our own simple drawings of the four main styles. Not to scale and not any specific brand's product.</figcaption>
</figure>
