---
import '../styles/global.css';
import { SITE_URL, SITE_NAME } from '../data/site.mjs';
import {
  LOCALE_META,
  localizePath,
  getHreflangMap,
  type Locale,
  DEFAULT_LOCALE,
} from '../i18n/locales';
import { getUi } from '../i18n/ui';
import LocaleSwitch from '../components/LocaleSwitch.astro';

interface Props {
  title: string;
  description: string;
  path: string; // locale-stripped, e.g. "/kindle-case/"
  locale?: Locale;
  jsonld?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}
const {
  title,
  description,
  path,
  locale = DEFAULT_LOCALE,
  jsonld = [],
  noindex = false,
  ogType = 'website',
} = Astro.props;

const meta = LOCALE_META[locale];
const ui = getUi(locale);
const localizedPath = localizePath(path, locale);
const canonical = new URL(localizedPath, SITE_URL).toString();
const ogImage = new URL('/og-default.png', SITE_URL).toString();
const hreflang = getHreflangMap(path);
const nav = ui.nav;
const more = ui.more;
const moreActive = more.some((m) => m.href === path);
const legalBlurb = ui.legalBlurb.replaceAll('{site}', SITE_NAME);
const copyright = ui.copyright.replaceAll('{site}', SITE_NAME);
---
<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="theme-color" content="#faf6ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      hreflang &&
        Object.entries(hreflang).map(([loc, href]) => (
          <link
            rel="alternate"
            hreflang={LOCALE_META[loc as Locale].htmlLang}
            href={new URL(href, SITE_URL).toString()}
          />
        ))
    }
    {hreflang && <link rel="alternate" hreflang="x-default" href={new URL(hreflang.en, SITE_URL).toString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-999px">{ui.skipToContent}</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={localizePath('/', locale)}>
          <svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><rect x="6" y="2" width="20" height="28" rx="3" fill="#1d1b18"/><rect x="9" y="5" width="14" height="19" rx="1" fill="#faf6ee"/><path d="M26 2v9l-3-2-3 2V2z" fill="#9a3b1f"/></svg>
          <span>{SITE_NAME} <small>{ui.tagline}</small></span>
        </a>
        <div class="header-tools">
          <nav class="main" aria-label={ui.navAria}>
            {nav.slice(0, 4).map((n) => (
              <a href={localizePath(n.href, locale)} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            ))}
            <details class="more">
              <summary aria-current={moreActive ? 'true' : undefined}>{ui.moreGuides}</summary>
              <div class="menu">
                {more.map((m) => (
                  <a href={localizePath(m.href, locale)} aria-current={path === m.href ? 'page' : undefined}>
                    {m.label}
                  </a>
                ))}
              </div>
            </details>
            {nav.slice(4).map((n) => (
              <a href={localizePath(n.href, locale)} aria-current={path === n.href ? 'page' : undefined}>
                {n.label}
              </a>
            ))}
          </nav>
          <LocaleSwitch locale={locale} path={path} />
        </div>
      </div>
    </header>
    <main id="main"><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap">
        <div class="cols">
          <div>
            <h2>{ui.footerGuides}</h2>
            <ul>
              {ui.footerGuideLinks.map((l) => (
                <li>
                  <a href={localizePath(l.href, locale)}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2>{ui.footerSite}</h2>
            <ul>
              {ui.footerSiteLinks.map((l) => (
                <li>
                  <a href={l.href === '/sitemap.xml' ? l.href : localizePath(l.href, locale)}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h2>{ui.footerLegal}</h2>
            <p class="small">{legalBlurb}</p>
          </div>
        </div>
        <p class="small">{copyright}</p>
      </div>
    </footer>
  </body>
</html>
