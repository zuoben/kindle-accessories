---
import Base from '../layouts/Base.astro';
import { getUi } from '../i18n/ui';
import { localizePath } from '../i18n/locales';

const ui = getUi('en');
---
<Base title={ui.notFoundTitle} description={ui.notFoundDescription} path="/404/" noindex>
  <h1>{ui.notFoundHeading}</h1>
  <p class="lede">{ui.notFoundLede}</p>
  <ul>
    <li><a href={localizePath('/kindle-paperwhite/', 'en')}>Kindle Paperwhite: which one to buy</a></li>
    <li><a href={localizePath('/kindle-case/', 'en')}>Kindle case buying guide</a></li>
    <li><a href={localizePath('/', 'en')}>{ui.home}</a></li>
  </ul>
</Base>
