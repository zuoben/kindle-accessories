---
import type { GetStaticPaths } from 'astro';
import LocPage from '../../components/LocPage.astro';
import { type Locale } from '../../i18n/locales';
import { availableI18nLocales, hasPageCopy } from '../../i18n/pages';

export const getStaticPaths = (() =>
  availableI18nLocales()
    .filter((lang) => hasPageCopy(lang, '/'))
    .map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---
<LocPage locale={lang} path="/" />
