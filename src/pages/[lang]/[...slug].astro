---
import type { GetStaticPaths } from 'astro';
import LocPage from '../../components/LocPage.astro';
import { PAGE_KEYS, type Locale } from '../../i18n/locales';
import { availableI18nLocales, hasPageCopy } from '../../i18n/pages';

export const getStaticPaths = (() =>
  availableI18nLocales().flatMap((lang) =>
    PAGE_KEYS.filter((p) => p !== '/' && hasPageCopy(lang, p)).map((path) => ({
      params: { lang, slug: path.replace(/^\//, '').replace(/\/$/, '') },
    }))
  )) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const path = `/${slug}/`;
---
<LocPage locale={lang} path={path} />
